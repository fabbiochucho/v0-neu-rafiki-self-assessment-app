# Supabase project URL and anon (public) key. Safe to expose to the browser --
# access is enforced by Row Level Security, not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Bypasses Row Level Security entirely. Server-only
# -- never prefix with NEXT_PUBLIC_, never send to the browser. Used only by
# app/api/** route handlers (see lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Symmetric key used with pgcrypto's pgp_sym_encrypt/pgp_sym_decrypt to
# encrypt assessment responses and results at rest (see
# scripts/010_encrypt_sensitive_columns.sql). Server-only -- never prefix
# with NEXT_PUBLIC_. Generate a long random value (e.g. `openssl rand -hex 32`)
# and store it in your secrets manager; rotating it requires re-encrypting
# existing rows.
ASSESSMENT_ENCRYPTION_KEY=
