# Supabase project URL and anon (public) key. Safe to expose to the browser --
# access is enforced by Row Level Security, not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Bypasses Row Level Security entirely. Server-only
# -- never prefix with NEXT_PUBLIC_, never send to the browser. Used only by
# app/api/** route handlers (see lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Symmetric key used with pgcrypto's pgp_sym_encrypt/pgp_sym_decrypt to
# encrypt assessment responses and results at rest (see
# scripts/010_encrypt_sensitive_columns.sql). Server-only -- never prefix
# with NEXT_PUBLIC_. Generate a long random value (e.g. `openssl rand -hex 32`)
# and store it in your secrets manager; rotating it requires re-encrypting
# existing rows.
ASSESSMENT_ENCRYPTION_KEY=

# --- Cross-app federation (Phase 1, optional) -------------------------------
# Lets a user optionally link their Neu Rafiki account to a sibling
# "Alliance" app account so completed assessment results can be shared (with
# explicit per-profile consent). Fully optional -- if
# NEXT_PUBLIC_ALLIANCE_APP_URL is unset, federation is disabled entirely and
# the app behaves exactly as it does today (see lib/federation/config.ts).

# Base URL of the sibling ANDA deployment, e.g. https://anda.becomechange.institute.
# Its presence is the single flag for "is federation enabled" in this app.
# Safe to expose to the browser (used for /connect, "Continue to ANDA" and
# "Manage ANDA" links). NEXT_PUBLIC_ALLIANCE_APP_URL is the older name and is
# still read as a fallback.
NEXT_PUBLIC_ANDA_APP_URL=
NEXT_PUBLIC_ALLIANCE_APP_URL=

# This app's own Ed25519 private key (PKCS8 PEM), used to sign link tokens
# this app issues. Server-only -- never prefix with NEXT_PUBLIC_. Real
# newlines are replaced with the two-character sequence \n so the whole key
# fits on one env var line (the same pattern commonly used for RSA private
# keys in env vars).
FEDERATION_PRIVATE_KEY=

# The sibling Alliance app's Ed25519 *public* key (SPKI PEM, same \n-escaping
# as above), used to verify tokens Alliance issued.
FEDERATION_ALLIANCE_PUBLIC_KEY=

# --- Error tracking (optional) ----------------------------------------------
# Sentry (see sentry.{client,server,edge}.config.ts + instrumentation.ts).
# Leaving these unset makes Sentry.init a no-op everywhere -- the app behaves
# exactly as it does today, just without error reporting.

# Client-visible DSN (safe to expose to the browser -- it's a write-only
# ingest endpoint, not a secret). Get this from your Sentry project settings.
NEXT_PUBLIC_SENTRY_DSN=

# Server/edge DSN. Usually the same value as NEXT_PUBLIC_SENTRY_DSN above.
SENTRY_DSN=

# Only needed to enable source map upload at build time (better stack traces
# in Sentry). Requires an org, project slug, and an auth token with the
# project:releases scope from https://sentry.io/settings/account/api/auth-tokens/.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Follow-up reminder emails (optional) -----------------------------------
# Sends an email via SMTP._HOST when a scheduled follow-up assessment
# (assessment_followup_schedules) becomes due, triggered daily by the Vercel
# Cron job in vercel.json hitting /api/cron/followup-reminders. Point these
# at any SMTP provider -- the same credentials you'd put in Supabase's
# Auth > SMTP Settings work here too, since Supabase Auth itself has no API
# for sending non-auth-flow emails. If unset, the cron job runs harmlessly
# and just logs a skip for each due schedule instead of throwing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Inbox address that /contact form submissions (app/api/contact/route.ts) are
# forwarded to. Falls back to SMTP_FROM if unset.
CONTACT_INBOX_EMAIL=

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" on every
# scheduled invocation (set this in Vercel's dashboard as CRON_SECRET and it
# does this automatically). If unset, the cron endpoint accepts any request
# -- fine for local testing, not for production.
CRON_SECRET=

# Absolute base URL used to build the link in reminder emails (e.g.
# https://neurafiki.example.com). Falls back to Vercel's own VERCEL_URL if
# unset, so this is only needed to override that on a custom domain.
NEXT_PUBLIC_SITE_URL=

# Generate a fresh Ed25519 keypair for this app with:
#   node -e "import('jose').then(async ({generateKeyPair, exportPKCS8, exportSPKI}) => { const {publicKey, privateKey} = await generateKeyPair('EdDSA', { extractable: true }); console.log('PRIVATE:', (await exportPKCS8(privateKey)).replace(/\n/g,'\\n')); console.log('PUBLIC:', (await exportSPKI(publicKey)).replace(/\n/g,'\\n')); })"
# Put the PRIVATE line's value in this app's FEDERATION_PRIVATE_KEY, and send
# the PUBLIC line's value to whoever runs the Alliance deployment to put in
# their FEDERATION_NEURAFIKI_PUBLIC_KEY (or equivalent). Alliance generates
# its own keypair the same way and sends you its public key for
# FEDERATION_ALLIANCE_PUBLIC_KEY above.

# --- Payments (Premium subscription) ----------------------------------------
# Powers app/dashboard/subscription and app/api/payments/flutterwave/**.
# Server-only -- never prefix with NEXT_PUBLIC_.

# Flutterwave secret key, used to create hosted payment links and verify
# transactions server-to-server. From the Flutterwave dashboard's API keys
# page (use the live secret key in production, test key in development).
FLUTTERWAVE_SECRET_KEY=

# Shared secret Flutterwave signs webhook requests with (sent as the
# "verif-hash" header). Set this to the same value configured in the
# Flutterwave dashboard's webhook settings. Required for
# app/api/payments/flutterwave/webhook to trust incoming requests.
FLUTTERWAVE_SECRET_HASH=

# --- AI companion (optional) ------------------------------------------------
# Server-only (lib/ai.ts). With none of these set the companion is switched off
# everywhere. Never prefix with NEXT_PUBLIC_. Usage limits live in
# lib/entitlements.ts (AI_DAILY_LIMIT); only per-day counts and timestamps are
# stored, never conversation content.
#
# Free option (owner's choice): Cloudflare Workers AI. Free plan includes a
# daily allowance and stops, never bills, when it runs out. API token needs
# "Workers AI" Read + Edit permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
# Optional. Defaults to @cf/meta/llama-3.3-70b-instruct-fp8-fast.
CLOUDFLARE_AI_MODEL=
# Paid alternative, used only if the Cloudflare settings are empty.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-haiku-5-5.
ANTHROPIC_MODEL=
