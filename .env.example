# Supabase project URL and anon (public) key. Safe to expose to the browser --
# access is enforced by Row Level Security, not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. Bypasses Row Level Security entirely. Server-only
# -- never prefix with NEXT_PUBLIC_, never send to the browser. Used only by
# app/api/** route handlers (see lib/supabase/service.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Symmetric key used with pgcrypto's pgp_sym_encrypt/pgp_sym_decrypt to
# encrypt assessment responses and results at rest (see
# scripts/010_encrypt_sensitive_columns.sql). Server-only -- never prefix
# with NEXT_PUBLIC_. Generate a long random value (e.g. `openssl rand -hex 32`)
# and store it in your secrets manager; rotating it requires re-encrypting
# existing rows.
ASSESSMENT_ENCRYPTION_KEY=

# --- Cross-app federation (Phase 1, optional) -------------------------------
# Lets a user optionally link their Neu Rafiki account to a sibling
# "Alliance" app account so completed assessment results can be shared (with
# explicit per-profile consent). Fully optional -- if
# NEXT_PUBLIC_ALLIANCE_APP_URL is unset, federation is disabled entirely and
# the app behaves exactly as it does today (see lib/federation/config.ts).

# Base URL of the sibling Alliance deployment, e.g. https://alliance.example.com.
# Its presence is the single flag for "is federation enabled" in this app.
# Safe to expose to the browser (used to build the /connect redirect link).
NEXT_PUBLIC_ALLIANCE_APP_URL=

# This app's own Ed25519 private key (PKCS8 PEM), used to sign link tokens
# this app issues. Server-only -- never prefix with NEXT_PUBLIC_. Real
# newlines are replaced with the two-character sequence \n so the whole key
# fits on one env var line (the same pattern commonly used for RSA private
# keys in env vars).
FEDERATION_PRIVATE_KEY=

# The sibling Alliance app's Ed25519 *public* key (SPKI PEM, same \n-escaping
# as above), used to verify tokens Alliance issued.
FEDERATION_ALLIANCE_PUBLIC_KEY=

# Generate a fresh Ed25519 keypair for this app with:
#   node -e "import('jose').then(async ({generateKeyPair, exportPKCS8, exportSPKI}) => { const {publicKey, privateKey} = await generateKeyPair('EdDSA', { extractable: true }); console.log('PRIVATE:', (await exportPKCS8(privateKey)).replace(/\n/g,'\\n')); console.log('PUBLIC:', (await exportSPKI(publicKey)).replace(/\n/g,'\\n')); })"
# Put the PRIVATE line's value in this app's FEDERATION_PRIVATE_KEY, and send
# the PUBLIC line's value to whoever runs the Alliance deployment to put in
# their FEDERATION_NEURAFIKI_PUBLIC_KEY (or equivalent). Alliance generates
# its own keypair the same way and sends you its public key for
# FEDERATION_ALLIANCE_PUBLIC_KEY above.
